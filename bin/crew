#!/usr/bin/env node
// The one tool a bot needs: talks to crewd with the bot's own token. Also the CLIs' hook target.
const [cmd, ...rest] = process.argv.slice(2);
const url = process.env.CREWHOUSE_URL, token = process.env.CREWHOUSE_TOKEN;
const usage = `usage:
  crew roster                          who is on the crew, which templates exist
  crew status                          open tasks
  crew recruit <template> [--name N]   (Chief) recruit a bot
  crew assign <bot> [--model M] "<task>"  (Chief) hand a bot a task; M picks the model for it, e.g. claude:haiku or codex
  crew routine <bot> "<when>" [--name N] [--model M] "<task>"  (Chief) a task on a schedule, e.g. "every Monday 9:00", "weekdays 8am", "every 2 hours"
  crew routines                        the routines and when each runs next
  crew call-me "<sir|ma'am|a name>"    (Chief) change how the person is addressed
  crew report "<progress line>"
  crew deliver <path> ["<note>"]       register a finished file (inside your folder)
  crew remember "<one short line>" [--replaces "<words of the old note>"]
                                       add to your notes (capped), or correct an old note`;
if (!url || !token) { console.error('crew: not running inside a Crewhouse bot (CREWHOUSE_URL/TOKEN unset)'); process.exit(2); }

async function stdinJson() {
  let raw = '';
  for await (const c of process.stdin) raw += c;
  try { return JSON.parse(raw || '{}'); } catch { return {}; }
}

// How long a call keeps trying while crewd restarts: just under each hook's own timeout (bots.ts launchSpec).
const PATIENCE = { 'hook/permission': 185_000, 'hook/tool': 8_000, 'hook/statusline': 0 };
const started = Date.now();

async function call(path, body) {
  const give = PATIENCE[path] ?? 25_000;
  let res;
  for (;;) {
    try {
      res = await fetch(`${url}/crew/${path}`, { method: 'POST', headers: { 'content-type': 'application/json', 'x-crew-token': token, 'x-crew-waited': String(Date.now() - started) }, body: JSON.stringify(body ?? {}) });
      break;
    } catch (e) { // crewd is down or restarting; answered calls never retry
      if (Date.now() - started + 1000 > give) throw e;
      await new Promise((r) => setTimeout(r, 1000));
    }
  }
  const out = await res.json().catch(() => ({}));
  if (!res.ok) { console.error(`crew: ${out.error ?? res.status}`); process.exit(1); }
  return out;
}

let body, path = cmd;
switch (cmd) {
  case 'roster': case 'status': case 'routines': body = {}; break;
  case 'routine': {
    body = { bot: rest[0], schedule: rest[1] };
    let i = 2;
    for (; ['--model', '--name'].includes(rest[i]); i += 2) body[rest[i].slice(2)] = rest[i + 1];
    body.task = rest.slice(i).join(' ');
    break;
  }
  case 'recruit': { const i = rest.indexOf('--name'); body = { template: rest[0], name: i >= 0 ? rest.slice(i + 1).join(' ') : undefined }; break; }
  case 'assign': {
    const m = rest[1] === '--model' ? rest[2] : undefined;
    body = { bot: rest[0]?.toLowerCase(), model: m, text: rest.slice(m ? 3 : 1).join(' ') };
    break;
  }
  case 'remember': { const i = rest.indexOf('--replaces'); body = i < 0 ? { text: rest.join(' ') } : { text: rest.slice(0, i).join(' '), replaces: rest.slice(i + 1).join(' ') }; break; }
  case 'report': case 'call-me': body = { text: rest.join(' ') }; break;
  case 'deliver': body = { path: rest[0], note: rest.slice(1).join(' ') }; break;
  case 'hook': {
    path = `hook/${rest[0]}`;
    // Codex passes its notification as an argument; Claude pipes JSON on stdin.
    body = rest[1] ? JSON.parse(rest[1]) : await stdinJson();
    const out = await call(path, body).catch(() => ({}));
    if (rest[0] === 'statusline') process.stdout.write(out.text ?? 'Crewhouse');
    else if (Object.keys(out).length) process.stdout.write(JSON.stringify(out));
    process.exit(0);
  }
  default: console.log(usage); process.exit(cmd ? 2 : 0);
}
console.log(JSON.stringify(await call(path, body).catch((e) => { console.error(`crew: Crewhouse is not answering (${e.cause?.code ?? e.message})`); process.exit(1); }), null, 2));
