#!/usr/bin/env bash
# Crewhouse: setup | start | open | autostart | update | uninstall | phones | doctor | tools | test
set -euo pipefail
cd "$(dirname "$0")"

need_node() {
  command -v node >/dev/null || { echo "Crewhouse needs Node 22.22.3 or later: https://nodejs.org" >&2; exit 1; }
  node -e 'const [a,b,c]=process.versions.node.split(".").map(Number); process.exit(a>22||(a===22&&(b>22||(b===22&&c>=3)))?0:1)' \
    || { echo "Crewhouse needs Node 22.22.3 or later (found $(node --version))" >&2; exit 1; }
}

# Where this Crewhouse keeps things, from the same config crewd reads (so env overrides agree).
paths() {
  IFS=$'\t' read -r STATE CREW TOOLS < <(node --input-type=module -e \
    "const { loadConfig } = await import('./src/config.ts'); const c = loadConfig(); console.log([c.stateDir, c.crewDir, c.toolsDir].join('\t'))")
}

# crewd's pid, only if that process really is this checkout's crewd.
crewd_pid() {
  local f="$STATE/crewd.pid" pid
  # ponytail: Linux /proc check; add a ps fallback when macOS is supported.
  [ -f "$f" ] && pid=$(cat "$f") && [ "$(readlink "/proc/$pid/cwd" 2>/dev/null)" = "$(pwd -P)" ] \
    && tr '\0' ' ' < "/proc/$pid/cmdline" | grep -q 'src/main.ts' && echo "$pid"
}

stop_crewd() {
  local pid; pid=$(crewd_pid) || return 1
  kill -TERM "$pid"
  for _ in $(seq 50); do kill -0 "$pid" 2>/dev/null || return 0; sleep 0.2; done
  echo "crewd (pid $pid) did not stop" >&2; exit 1
}

# Start with the computer: a systemd user service, so a reboot or a login brings the crew back with no terminal.
# ponytail: Linux with systemd only; a macOS LaunchAgent when macOS is supported.
UNIT="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/crewhouse.service"
has_systemd() { command -v systemctl >/dev/null && systemctl --user show-environment >/dev/null 2>&1; }
autostart_on() {
  has_systemd || { echo "This computer has no systemd user session, so Crewhouse can't start by itself here. Use ./crewhouse start." >&2; return 1; }
  # Helpers fetch their tools on first use, wherever crewd starts from: the unit carries the same marker start sets.
  export CREWHOUSE_FIRST_USE_TOOLS=1
  mkdir -p "$(dirname "$UNIT")"
  cat > "$UNIT" <<UNIT
[Unit]
Description=Crewhouse (crewd)
After=network-online.target

[Service]
WorkingDirectory=$(pwd -P)
ExecStart=$(node -p process.execPath) src/main.ts
Restart=on-failure
$(env | grep '^CREWHOUSE_' | sed 's/^/Environment=/')

[Install]
WantedBy=default.target
UNIT
  systemctl --user daemon-reload
  systemctl --user enable --now crewhouse.service >/dev/null
  echo "Crewhouse now starts by itself when you log in, and is running now."
}
autostart_off() {
  [ -f "$UNIT" ] || return 0
  has_systemd && systemctl --user disable --now crewhouse.service >/dev/null 2>&1 || true
  rm -f "$UNIT"
  has_systemd && systemctl --user daemon-reload || true
}
autostarted() { [ -f "$UNIT" ] && has_systemd && systemctl --user is-active --quiet crewhouse.service; }

# Refuse to delete anything that isn't plainly a Crewhouse folder.
remove() {
  case "$1" in ""|/|"$HOME"|"$HOME/"|"$(pwd)") echo "refusing to delete '$1'" >&2; exit 1 ;; esac
  # The engine is a supervised child process: right after stop it can still hold files open (its compile cache
  # has raced rm here), so a removal that loses the race waits and retries instead of failing the first uninstall.
  for _ in $(seq 30); do
    if rm -rf -- "$1" 2>/dev/null && [ ! -e "$1" ]; then return 0; fi
    sleep 0.5
  done
  rm -rf -- "$1"
}

# The engine install takes about two minutes, and its longest phase prints nothing itself: a line every
# 10 s so setup never looks hung. The shell counts, not node: the installer's own event loop can block
# for almost a minute while it verifies the engine set, which would stall an in-process heartbeat.
prepare_engine() {
  local eng started el
  node scripts/prepare-engine.mjs & eng=$!
  trap 'kill "$eng" 2>/dev/null; exit 130' INT TERM
  started=$(date +%s)
  while kill -0 "$eng" 2>/dev/null; do
    sleep 10
    kill -0 "$eng" 2>/dev/null || break
    el=$(($(date +%s) - started))
    printf 'Installing the AI engine… %d:%02d elapsed\n' $((el / 60)) $((el % 60))
  done
  trap - INT TERM
  wait "$eng"
}

case "${1:-}" in
  setup)
    need_node
    npm ci --no-audit --no-fund
    echo "Installing the AI engine (this can take a couple of minutes; it reports progress as it goes)."
    prepare_engine
    npm run build:web
    # Helpers fetch their own tools the first time they need them: setup installs nothing beyond the engine.
    echo "Helpers fetch their own tools the first time they need them, so there is nothing more to install."
    echo
    node src/doctor.ts || true
    echo
    if [ -t 0 ] && has_systemd && [ ! -f "$UNIT" ]; then
      read -r -p "Start Crewhouse by itself whenever you log in? [Y/n] " yn
      case "${yn:-y}" in [Yy]*) autostart_on && { echo "Open Crewhouse from the app menu, or run ./crewhouse open"; exit 0; } ;; esac
    fi
    echo "Next: ./crewhouse start, which opens Crewhouse in your browser."
    ;;
  autostart)
    need_node
    case "${2:-}" in
      on) autostart_on ;;
      off) autostart_off; echo "Crewhouse no longer starts by itself." ;;
      *) echo "usage: ./crewhouse autostart on | off" >&2; exit 2 ;;
    esac
    ;;
  start)
    need_node
    [ -f web/dist/index.html ] || npm run build:web
    if autostarted; then echo "Crewhouse is already running; open it from the app menu or run ./crewhouse open"; exit 0; fi
    paths
    # Helpers fetch their tools on first use (see src/server.ts): crewd installs them itself, so setup stays short.
    export CREWHOUSE_FIRST_USE_TOOLS=1
    # This checkout's app address, once its crewd answers. The URL carries the private capability, so only the browser gets it.
    app_url() {
      node --input-type=module - <<'NODE' 2>/dev/null
import { existsSync, readFileSync } from 'node:fs';
import { join } from 'node:path';
import { loadConfig } from './src/config.ts';
try {
  const c = loadConfig(), key = join(c.stateDir, 'person.key');
  if (!existsSync(key)) process.exit(1);
  const authority = readFileSync(key, 'utf8');
  const r = await fetch(`http://${c.host}:${c.port}/api/state`, { headers: { 'x-crewhouse': '1', authorization: `Bearer ${authority}` } });
  if (!r.ok) process.exit(1);
  console.log(`http://${c.host}:${c.port}/#person=${authority}`);
} catch { process.exit(1); }
NODE
    }
    open_url() {
      if command -v xdg-open >/dev/null; then (xdg-open "$1" >/dev/null 2>&1 &)
      elif command -v open >/dev/null; then (open "$1" >/dev/null 2>&1 &)
      else echo "Open ${1%%#*} in your browser."; fi
    }
    if pid=$(crewd_pid); then
      url=$(app_url) || { echo "Crewhouse is running (pid $pid) but not answering yet; try ./crewhouse open in a moment." >&2; exit 1; }
      open_url "$url"
      echo "Crewhouse is already running; opened ${url%%#*} in your browser."
      exit 0
    fi
    node src/main.ts & crewd=$!
    trap 'kill "$crewd" 2>/dev/null; exit 130' INT TERM
    url=
    for _ in $(seq 360); do
      url=$(app_url) || true
      [ -n "$url" ] && break
      kill -0 "$crewd" 2>/dev/null || { wait "$crewd"; exit $?; }
      sleep 0.5
    done
    trap - INT TERM
    if [ -z "$url" ]; then
      echo "Crewhouse is taking a while to answer. It keeps starting in this terminal; open it with ./crewhouse open once it does."
    else
      open_url "$url"
      echo "Crewhouse is up at ${url%%#*}."
    fi
    wait "$crewd"
    ;;
  update)
    need_node
    # Pull, install, build, and only then restart, so crewd is down for a second, not for an install.
    if [ -n "$(git status --porcelain)" ]; then
      echo "This Crewhouse folder has local changes, so it was not updated:" >&2
      git status --short >&2
      echo "Commit or discard them, then run ./crewhouse update again." >&2
      exit 1
    fi
    before=$(git rev-parse HEAD)
    git pull --ff-only
    if [ "$(git rev-parse HEAD)" = "$before" ]; then echo "Already up to date."; exit 0; fi
    npm ci --no-audit --no-fund
    prepare_engine
    npm run build:web
    paths
    # A restarted crewd keeps fetching helpers' tools on first use, like start.
    export CREWHOUSE_FIRST_USE_TOOLS=1
    # A tool whose pin moved (a new version, or a new program) is reinstalled now, before crewd comes back.
    node src/tools.ts install --refresh || echo "A tool didn't update; ./crewhouse tools install tries again." >&2
    if autostarted; then
      systemctl --user restart crewhouse.service
      echo "Updated to $(git log -1 --format='%h %s'). crewd restarted; running work carries on."
    elif stop_crewd; then
      mkdir -p "$STATE"
      nohup node src/main.ts >> "$STATE/crewd.log" 2>&1 &
      echo "Updated to $(git log -1 --format='%h %s'). crewd restarted; running work carries on (log: $STATE/crewd.log)."
    else
      echo "Updated to $(git log -1 --format='%h %s'). Start it with ./crewhouse start."
    fi
    ;;
  uninstall)
    need_node
    paths
    all=; yes=
    for a in "${@:2}"; do
      case "$a" in --all) all=1 ;; --yes|-y) yes=1 ;; *) echo "usage: ./crewhouse uninstall [--all] [--yes]" >&2; exit 2 ;; esac
    done
    echo "This removes what Crewhouse installed:"
    echo "  $STATE  (the database, the engine's own folder, saved AI sign-ins, desktops, log)"
    echo "  $TOOLS  (pinned tools)"
    echo "  node_modules and web/dist in $(pwd)"
    if [ -n "$all" ]; then echo "  $CREW  (your crew: every bot's notes, skills and files)"
    else echo "Your crew stays in $CREW (every bot's notes, skills and files). Add --all to remove it too."; fi
    if [ -z "$yes" ]; then
      [ -t 0 ] || { echo "Run it in a terminal, or add --yes." >&2; exit 1; }
      read -r -p "Go ahead? [y/N] " ok
      case "$ok" in [Yy]*) ;; *) echo "Nothing was removed."; exit 0 ;; esac
    fi
    autostart_off
    stop_crewd || true
    # The installed web app's https address (./crewhouse phones web), when Tailscale still serves this link.
    ! tailscale serve status --json 2>/dev/null | grep -F >/dev/null "\"http://127.0.0.1:${CREWHOUSE_LINK_PORT:-7712}\"" || tailscale serve --https=$((${CREWHOUSE_LINK_PORT:-7712} + 1)) off
    remove "$STATE"
    remove "$TOOLS"
    rmdir "$(dirname "$TOOLS")" 2>/dev/null || true
    remove node_modules
    remove web/dist
    [ -n "$all" ] && remove "$CREW"
    echo "Crewhouse is uninstalled. To remove the code as well, delete $(pwd)."
    ;;
  open)
    need_node
    node --input-type=module - <<'NODE'
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import { spawn } from 'node:child_process';
import { loadConfig } from './src/config.ts';
const c = loadConfig();
spawn('xdg-open', [`http://${c.host}:${c.port}/#person=${readFileSync(join(c.stateDir, 'person.key'), 'utf8')}`], { stdio: 'inherit' });
NODE
    ;;
  phones)
    # Local HTTP client; reads the same config and private capability as the launcher.
    action="${2:-}"; shift 2 || true
    case "$action" in code|pending|approve|web) ;; *) echo 'usage: ./crewhouse phones code | pending | approve <two words> | web [off]' >&2; exit 2 ;; esac
    if [ "$action" = web ]; then
      # The installed web app pairs only on an https page (the browser seals its grant with crypto that plain http lacks).
      # Tailscale serves the phone link, which serves the app too, at this computer's tailnet name with a real certificate.
      link=${CREWHOUSE_LINK_PORT:-7712}; port=$((link + 1))
      command -v tailscale >/dev/null || { echo 'The installed web app needs Tailscale on this computer and on the iPad or phone: https://tailscale.com/download' >&2; exit 1; }
      if [ "${1:-}" = off ]; then exec tailscale serve --https="$port" off; fi
      name=$(tailscale status --json | node -e 'let s = ""; process.stdin.on("data", (d) => s += d).on("end", () => console.log(JSON.parse(s).Self?.DNSName?.replace(/\.$/, "") ?? ""))')
      [ -n "$name" ] || { echo 'Tailscale is not signed in here. Run: tailscale up' >&2; exit 1; }
      tailscale serve --bg --https="$port" "http://127.0.0.1:$link" >/dev/null || exit 1
      echo "On the iPad or phone (signed in to the same Tailscale), open this in Safari or Chrome and add it to the Home Screen:"
      echo "  https://$name:$port"
      echo "Open it from the Home Screen, tap Pair, and paste the code from ./crewhouse phones code. Turn this off with ./crewhouse phones web off."
      exit
    fi
    [ "$action" != approve ] || [ "$#" -gt 0 ] || { echo 'Give the exact two words shown on the phone.' >&2; exit 2; }
    node --input-type=module - "$action" "$*" <<'NODE'
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import { loadConfig } from './src/config.ts';
import { relayTyped } from './web/src/typed.ts';
const [action, words] = process.argv.slice(2);
const port = Number(process.env.CREWHOUSE_PORT || 7711);
const phones = async (path, body) => {
  const res = await fetch(`http://127.0.0.1:${port}/api/phones/${path}`, {
    method: body ? 'POST' : 'GET', headers: { 'x-crewhouse': '1', 'content-type': 'application/json',
      authorization: `Bearer ${readFileSync(join(loadConfig().stateDir, 'person.key'), 'utf8')}` },
    body: body && JSON.stringify(body),
  });
  const data = await res.json();
  if (!res.ok) throw new Error(data.error || 'Could not reach Crewhouse');
  return data;
};
try {
  const data = await phones(action === 'code' ? 'pair' : action, action === 'pending' ? undefined : action === 'approve' ? { words } : { role: 'control' });
  if (action === 'code') {
    console.log(`${data.typed}\nWorks once; expires ${new Date(data.expires).toLocaleString()}.`);
    // From anywhere (a phone, the web app at its public address): the relay's code, when this computer has a relay.
    const away = await phones('code', { role: 'control' }).catch(() => null);
    if (away) console.log(`\nAway from this computer, paste this one instead:\n${relayTyped(away.short, away.code, away.relay)}`);
  }
  else if (action === 'pending') console.log(data.length ? data.map((a) => `${a.name}: ${a.words}`).join('\n') : 'No phone waiting.');
  else console.log('Phone approved.');
} catch (e) { console.error(e.message); process.exitCode = 1; }
NODE
    ;;
  doctor)
    need_node
    exec node src/doctor.ts
    ;;
  tools)
    need_node
    shift
    exec node src/tools.ts "$@"
    ;;
  test)
    need_node
    # The tests run in a throwaway HOME; and the owner's own Pi (its sign-ins, settings, extensions) must come out of
    # a run byte for byte as it went in. Its sessions are left out: the owner's own pi writes those as it runs.
    pi_state() { [ -d "$HOME/.pi/agent" ] || return 0; (cd "$HOME/.pi/agent" && find auth.json settings.json models.json extensions -type f 2>/dev/null | sort | xargs -r sha256sum); }
    before=$(pi_state)
    npm test
    [ "$(pi_state)" = "$before" ] || { echo "~/.pi changed while the tests ran" >&2; exit 1; }
    [ -z "$before" ] || echo "~/.pi: sign-ins, settings and extensions unchanged, byte for byte."
    ;;
  *)
    echo "usage: ./crewhouse setup | start | autostart on|off | update | uninstall [--all] [--yes] | doctor | tools [install [ids...]] | test"
    exit 2
    ;;
esac
