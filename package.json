{
  "name": "crewhouse",
  "version": "0.1.4",
  "private": false,
  "description": "A crew of AI helpers that does your errands on your own computer, and asks before it spends.",
  "keywords": [
    "ai-agent",
    "personal-assistant",
    "self-hosted",
    "local-first",
    "linux",
    "privacy",
    "openclaw"
  ],
  "homepage": "https://crewhouse.pages.dev",
  "license": "Apache-2.0",
  "repository": { "type": "git", "url": "git+https://github.com/umeranjum17/crewhouse.git" },
  "type": "module",
  "engines": {
    "node": ">=24.16.0 <25 || >=26.1.0"
  },
  "bin": { "crewhouse": "bin/crewhouse.mjs" },
  "files": ["bin", "dist", "web/dist", "templates", "skills", "tools", "scripts/prepare-engine.mjs", "scripts/build-web.mjs", "scripts/grok-recipe.mjs", "scripts/claude-skill.mjs", "src/openclaw/*.json", "package.json", "package-lock.json", "crewhouse"],
  "scripts": {
    "prepack": "npm run build:web && npm run build:cli",
    "build:cli": "node scripts/build-cli.mjs",
    "start": "CREWHOUSE_RUN_MODE=${CREWHOUSE_RUN_MODE:-product} node src/main.ts",
    "build:web": "node scripts/build-web.mjs",
    "test": "node scripts/test.mjs",
    "check": "tsc"
  },
  "dependencies": {
    "@byokit/accounts": "0.30.0",
    "@byokit/cloud": "0.2.1",
    "@byokit/connect": "0.7.0",
    "@byokit/discover": "0.8.5",
    "@byokit/openclaw": "0.27.2",
    "@byokit/pair": "0.10.4",
    "@byokit/relay": "0.8.2",
    "@byokit/secrets": "0.5.2",
    "@byokit/ui-core": "0.7.0",
    "@desklink/host": "0.5.8",
    "docx": "9.7.2",
    "exceljs": "4.4.0",
    "jszip": "3.10.2",
    "marked": "18.0.11",
    "typebox": "1.3.16",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@desklink/react-native": "0.5.8",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "emulate": "0.12.2",
    "esbuild": "^0.28.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0"
  }
}
