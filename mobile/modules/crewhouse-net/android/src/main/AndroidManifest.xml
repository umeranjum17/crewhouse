<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- One still of the screen for "Hand my screen to…" (CrewhouseScreenModule.kt): the phone asks every time. -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
  <!-- The link to the computer, kept while the app is closed, and back after a reboot (LinkService.kt). -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_REMOTE_MESSAGING" />
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
  <!-- Speaking to Chief (CrewhouseVoiceModule.kt) asks whether the phone has a speech service to fall back on. -->
  <queries>
    <intent><action android:name="android.speech.RecognitionService" /></intent>
  </queries>
  <application>
    <!-- "Ask Crewhouse" on text picked in any app: the words go to the share screen, where the person picks who gets them. -->
    <activity
      android:name="expo.modules.crewhousenet.AskActivity"
      android:label="Ask Crewhouse"
      android:theme="@android:style/Theme.Translucent.NoTitleBar"
      android:excludeFromRecents="true"
      android:taskAffinity=""
      android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.PROCESS_TEXT" />
        <category android:name="android.intent.category.DEFAULT" />
        <data android:mimeType="text/plain" />
      </intent-filter>
    </activity>
    <activity
      android:name="expo.modules.crewhousenet.ScreenFrameActivity"
      android:theme="@android:style/Theme.Translucent.NoTitleBar"
      android:excludeFromRecents="true"
      android:taskAffinity=""
      android:exported="false" />
    <service
      android:name="expo.modules.crewhousenet.ScreenFrameService"
      android:foregroundServiceType="mediaProjection"
      android:exported="false" />
    <service
      android:name="expo.modules.crewhousenet.LinkService"
      android:foregroundServiceType="remoteMessaging"
      android:exported="false" />
    <receiver android:name="expo.modules.crewhousenet.LinkStarter" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.BOOT_COMPLETED" />
        <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
      </intent-filter>
    </receiver>
    <!-- "Write it here" (CrewhouseAccessibilityService.kt): the box the person is typing in, only when they ask. -->
    <service
      android:name="expo.modules.crewhousenet.CrewhouseAccessibilityService"
      android:label="@string/crewhouse_accessibility_label"
      android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
      android:exported="true">
      <intent-filter>
        <action android:name="android.accessibilityservice.AccessibilityService" />
      </intent-filter>
      <meta-data android:name="android.accessibilityservice" android:resource="@xml/crewhouse_accessibility" />
    </service>
  </application>
</manifest>
